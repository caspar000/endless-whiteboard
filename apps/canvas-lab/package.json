{
	"name": "@lifeboard/canvas-lab",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "A page that mounts the canvas fork on its own, so each phase of docs/canvas-fork-plan.md is checked before Lifeboard uses it.",
	"scripts": {
		"dev": "vite --port 5190",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test:e2e": "playwright test",
		"sync-server": "node sync-server.ts"
	},
	"dependencies": {
		"@lifeboard/canvas": "workspace:*",
		"@lifeboard/canvas-assets": "workspace:*",
		"@lifeboard/canvas-editor": "workspace:*",
		"@lifeboard/canvas-sync": "workspace:*",
		"@lifeboard/node-kit": "workspace:*",
		"@lifeboard/schema": "workspace:*",
		"@tiptap/core": "^3.29.2",
		"@tiptap/pm": "^3.29.2",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.0",
		"@tldraw/tlschema": "5.5.2",
		"@tldraw/utils": "5.5.2",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.3",
		"@types/ws": "^8.18.1",
		"@vitejs/plugin-react": "^5.2.0",
		"typescript": "5.9.3",
		"vite": "^8.1.5",
		"ws": "^8.21.3"
	}
}
