{
	"extends": "../../packages/canvas/tsconfig.json",
	"compilerOptions": {
		"types": ["node", "vite/client"],
		// `paths` replaces the base's, so the data packages' mappings are repeated; `tldraw` is the fork,
		// for Lifeboard's packages (lifeboard.tsx).
		"paths": {
			"tldraw": ["../../packages/canvas/src/index.ts"],
			"@tldraw/state": ["../../packages/canvas-editor/node_modules/@tldraw/state/src/index.ts"],
			"@tldraw/state-react": ["../../packages/canvas-editor/node_modules/@tldraw/state-react/src/index.ts"],
			"@tldraw/store": ["../../packages/canvas-editor/node_modules/@tldraw/store/src/index.ts"],
			"@tldraw/tlschema": ["../../packages/canvas-editor/node_modules/@tldraw/tlschema/src/index.ts"],
			"@tldraw/utils": ["../../packages/canvas-editor/node_modules/@tldraw/utils/src/index.ts"],
			"@tldraw/validate": ["../../packages/canvas-editor/node_modules/@tldraw/validate/src/index.ts"]
		}
	},
	"include": ["src", "e2e", "vite.config.ts", "playwright.config.ts"],
	// Loaded at run time only; see main.tsx.
	"exclude": ["src/lifeboard.tsx"]
}
