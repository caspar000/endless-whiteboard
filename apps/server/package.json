{
	"name": "@lifeboard/server",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build",
		"dev": "vite build --watch & node --watch --enable-source-maps dist/main.js",
		"typecheck": "tsc -p tsconfig.json",
