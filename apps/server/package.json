		"start": "node --enable-source-maps dist/main.js",
		"hash-password": "node src/hashPasswordCli.ts"
	},
	"dependencies": {
		"@fastify/cookie": "^11.1.2",
		"@fastify/static": "^10.1.5",
		"@fastify/websocket": "^11.3.3",
		"@lifeboard/schema": "workspace:*",
		"@tldraw/sync-core": "5.5.2",
		"@tldraw/tlschema": "5.5.2",
		"fastify": "^5.12.5",
		"fflate": "^0.8.3"
	},
	"devDependencies": {
		"@types/node": "^26.1.2",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tldraw": "5.5.2",
		"typescript": "5.9.3",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	}
