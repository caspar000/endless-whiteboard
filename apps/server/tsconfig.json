{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		// Bundled by Vite (see vite.config.ts), because the schema it imports is the app's own TypeScript
		// and TSX. `.ts` specifiers keep the few files Node runs directly (the password CLI) runnable.
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"types": ["node", "vite/client"]
	},
	"include": ["src"]
}
