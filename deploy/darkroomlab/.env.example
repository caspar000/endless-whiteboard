# Copy to /opt/stacks/lifeboard/.env and `chmod 600` it.

# A fine-grained GitHub token with read-only "Contents" access to the repo.
GITHUB_TOKEN=
LIFEBOARD_REPO=caspar000/endless-whiteboard
# The branch a restart deploys.
LIFEBOARD_BRANCH=main

# Paste the whole line printed by `pnpm --filter @lifeboard/server hash-password`, quotes included.
LIFEBOARD_PASSWORD_HASH=''
# `openssl rand -hex 32`. Changing it logs out every device.
LIFEBOARD_SESSION_SECRET=

# Read at build time. Without a key, tldraw hides the canvas 5 seconds after load on a public domain.
VITE_TLDRAW_LICENSE_KEY=
