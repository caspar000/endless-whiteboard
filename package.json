{
  "name": "lifeboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "pnpm agent:build && pnpm --filter @lifeboard/web dev",
    "agent:build": "pnpm --filter @lifeboard/mcp-server build && pnpm --filter @lifeboard/agent-host build",
    "build": "pnpm --filter @lifeboard/node-kit build && pnpm --filter @lifeboard/web build && pnpm --filter @lifeboard/server build",
    "agent": "pnpm agent:build && pnpm --filter @lifeboard/agent-host start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @lifeboard/web test:e2e",
    "lint": "pnpm -r --if-present lint",
    "server": "pnpm --filter @lifeboard/server start",
    "check:licences": "node scripts/check-licences.mjs"
  }
}
