{
	// Upstream extended the monorepo's base config, which isn't part of the fork. Plain JS with
	// hand-written .d.ts files; nothing here is compiled.
	"compilerOptions": {
		"allowJs": true,
		"checkJs": false,
		"noEmit": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "ES2022",
		"skipLibCheck": true
	},
	"include": ["*.js", "*.d.ts"]
}
