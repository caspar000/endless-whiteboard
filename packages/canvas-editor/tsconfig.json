{
	// Upstream's compiler settings (upstream-config/tsconfig.base.json in canvas-editor), not the
	// workspace's: this is their code, and the workspace's stricter flags would flag thousands of lines
	// that are fine. Tightening them is a later, separate change.
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["dom", "DOM.Iterable", "ESNext"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noImplicitAny": true,
		"noFallthroughCasesInSwitch": true,
		"experimentalDecorators": true,
		"useDefineForClassFields": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"noEmit": true,
		"types": ["node", "jest", "vite/client"],
		// The published data packages strip @internal APIs from their .d.ts, and the editor uses some across
		// packages. Their src/ ships in the tarball, so types come from there; the runtime JS has everything.
		"paths": {
			"@tldraw/state": ["./node_modules/@tldraw/state/src/index.ts"],
			"@tldraw/state-react": ["./node_modules/@tldraw/state-react/src/index.ts"],
			"@tldraw/store": ["./node_modules/@tldraw/store/src/index.ts"],
			"@tldraw/tlschema": ["./node_modules/@tldraw/tlschema/src/index.ts"],
			"@tldraw/utils": ["./node_modules/@tldraw/utils/src/index.ts"],
			"@tldraw/validate": ["./node_modules/@tldraw/validate/src/index.ts"]
		}
	},
	"include": ["src"]
}
