{
	"name": "@lifeboard/mcp-server",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"bin": {
		"lifeboard-mcp": "./dist/index.js"
	},
	"//exports": "Submodules only, never '.': `index.js` is the stdio entry point and running it as a side effect of an import would start a second server.",
	"exports": {
		"./bridge": {
			"types": "./dist/bridge.d.ts",
			"default": "./dist/bridge.js"
		},
		"./protocol": {
			"types": "./dist/protocol.d.ts",
			"default": "./dist/protocol.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"default": "./dist/server.js"
		},
		"./tools": {
			"types": "./dist/tools.d.ts",
			"default": "./dist/tools.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run",
		"start": "node dist/index.js"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"ws": "^8.21.3"
	},
	"devDependencies": {
		"@types/node": "^26.1.2",
		"@types/ws": "^8.18.1",
		"typescript": "5.9.3",
		"vitest": "^4.1.10"
	}
}
